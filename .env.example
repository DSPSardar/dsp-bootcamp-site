# Google Sheets integration for lead capture
# Get this from: Extensions → Apps Script → Deploy → Web app
# Copy the full deployment URL
GOOGLE_SHEETS_WEBHOOK_URL=

# Optional — if set, leads are emailed to LEAD_EMAIL via Resend
RESEND_API_KEY=
LEAD_EMAIL=

# GA4 measurement ID override. The production property (G-2HCL48T58X) is the
# default in src/components/site/Analytics.tsx; set this only to point a
# local/preview build at a different property.
NEXT_PUBLIC_GA4_ID=

# Bunny Stream (course video hosting for /mastery)
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_CDN_HOST=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_TOKEN_KEY=

# Gate for /mastery/preview
MASTERY_PREVIEW_KEY=

# Supabase (student dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret for POST /api/mastery/enrol (ASOS / checkout webhook)
MASTERY_ENROL_SECRET=
NEXT_PUBLIC_SITE_URL=https://digitalservicesprogram.com

# ASOS (DSP CRM) — learning events → WhatsApp nudges
ASOS_EVENTS_URL=https://api.dspagenthub.com/webhooks/mastery
ASOS_EVENTS_SECRET=
